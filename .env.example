# Copia este archivo como .env (no se sube al repo). Expo lo lee solo al compilar o al iniciar Metro (601).
# Valores de desarrollo (los mismos de app.json -> extra; el celular llega por adb reverse). Sin definir o vacías,
# se usan esos. Para un APK que apunte a la nube: la dirección pública de Keycloak (sin /realms) y la de Sincronización.
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
EXPO_PUBLIC_SINCRONIZACION_URL=http://localhost:8084
